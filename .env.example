RTMS_PORT=3002
RTMS_ZOOM_CLIENT_ID=your_zoom_app_client_id
RTMS_ZOOM_CLIENT_SECRET=your_zoom_app_client_secret
ZOOM_SECRET_TOKEN=your_zoom_webhook_secret_token
# Set to 2 for the supplied Zoom Phone integration; confirm with your RTMS account/version.
RTMS_PROTOCOL_VERSION=2
RTMS_AUDIO_SEND_RATE_MS=20
RTMS_ENABLE_AUDIO=true
RTMS_ENABLE_TRANSCRIPT=true
RTMS_LOG_TRANSCRIPTS=true
# Set false to avoid writing transcript text to process logs.
RTMS_WEBHOOK_MAX_AGE_SECONDS=300
RTMS_MAX_SESSIONS=100
RTMS_LOG_LEVEL=info
# Credential-free viewer preview; disables Zoom webhooks when true.
RTMS_DEMO_MODE=false
